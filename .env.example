# Supabase（已有项目，值来自 public/app/supabase-config.js，anon key 可公开）
VITE_SUPABASE_URL=https://kmkgbczjukbvktuxejhr.supabase.co
VITE_SUPABASE_ANON_KEY=

# Cloudflare Worker 运行时校验 /api/ai 的 Supabase 会话；值必须与浏览器配置一致
SUPABASE_URL=https://kmkgbczjukbvktuxejhr.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# OpenAI（服务端专用，绝不进浏览器）
OPENAI_API_KEY=

# Daytona 沙盒（比赛技术要求，服务端专用）。key 来自 app.daytona.io/dashboard/keys
DAYTONA_API_KEY=
# 可选：DAYTONA_API_URL（默认 https://app.daytona.io/api）、DAYTONA_TARGET（us / eu）
DAYTONA_TARGET=us
# 可选：复用固定沙盒（name 或 UUID），停了会自动拉起、跑完不删；不设则每次新建即删
DAYTONA_SANDBOX=
